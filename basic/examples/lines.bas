10 REM STRING ART: STRAIGHT LINES THAT MAKE CURVES
20 CLS
30 FOR K=0 TO 60 STEP 4
40 A=0: B=K: C=2*K+6: D=61: GOSUB 1000
50 A=127: B=61-K: C=121-2*K: D=0: GOSUB 1000
60 NEXT K
70 GOTO 70
1000 REM A LINE FROM A,B TO C,D (BRESENHAM)
1010 X=A: Y=B: U=ABS(C-A): V=ABS(D-B)
1020 S=1: IF C<A THEN S=-1
1030 T=1: IF D<B THEN T=-1
1040 E=U-V
1050 PLOT X,Y
1060 IF X=C THEN IF Y=D THEN RETURN
1070 F=E+E
1080 IF F>-V THEN E=E-V: X=X+S
1090 IF F<U THEN E=E+U: Y=Y+T
1100 GOTO 1050
