01.01 C GUESS THE NUMBER: FRAN PICKS ONE FROM 1 TO 100
01.10 SET N=FITR(FRAN()*100)+1; SET T=0
01.20 TYPE "I AM THINKING OF A NUMBER FROM 1 TO 100",!
01.30 ASK "YOUR GUESS", G; SET T=T+1
01.40 IF (G-N) 1.6,1.7
01.50 TYPE "TOO BIG",!; GOTO 1.3
01.60 TYPE "TOO SMALL",!; GOTO 1.3
01.70 TYPE "RIGHT, IN",T," GUESSES",!
