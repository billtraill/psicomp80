 "offsheet": [
  {
   "net": "KBD_D0",
   "label": "D0",
   "note": "inverted keyboard data bit 0 (IC54 B1, pin 15) to J_KBD / IC13 (CPU, Fig. 2)"
  },
  {
   "net": "KBD_D1",
   "label": "D1",
   "note": "inverted keyboard data bit 1 (IC54 B2, pin 14) to J_KBD / IC13 (CPU, Fig. 2)"
  },
  {
   "net": "KBD_D2",
   "label": "D2",
   "note": "inverted keyboard data bit 2 (IC54 B3, pin 13) to J_KBD / IC13 (CPU, Fig. 2)"
  },
  {
   "net": "KBD_D3",
   "label": "D3",
   "note": "inverted keyboard data bit 3 (IC54 B4, pin 12) to J_KBD / IC13 (CPU, Fig. 2)"
  },
  {
   "net": "KBD_D4",
   "label": "D4",
   "note": "inverted keyboard data bit 4 (IC54 B5, pin 11) to J_KBD / IC13 (CPU, Fig. 2)"
  },
  {
   "net": "KBD_D5",
   "label": "D5",
   "note": "inverted keyboard data bit 5 (IC54 B6, pin 10) to J_KBD / IC13 (CPU, Fig. 2)"
  },
  {
   "net": "KBD_D6",
   "label": "D6",
   "note": "inverted keyboard data bit 6 (IC54 B7, pin 9) to J_KBD / IC13 (CPU, Fig. 2)"
  },
  {
   "net": "KBD_STROBE",
   "label": "Strobe",
   "note": "positive strobe (IC55 pin 3), high while a key is held and the code is valid; to J_KBD / CPU NMI logic (Fig. 2)"
  },
  {
   "net": "KBD_RESET_KEY",
   "label": "RESET",
   "note": "RESET key, shorts to GND when pressed; merge with the CPU reset node (RESET_N or its RC/transistor input) from Fig. 2"
  },
  {
   "net": "HALT_N",
   "label": "HALT",
   "note": "Z80 HALT (pin 18), Fig. 2; drives D12 via 560R (Fig. 18)"
  },
  {
   "net": "-12V",
   "label": "-12V",
   "note": "IC54 VGG. Fig. 18 shows a -12V pin on the Carter 756 keyboard connector, so the article design supplies -12V; check PSU figure"
  },
