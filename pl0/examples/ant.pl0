{ LANGTON'S ANT IN COMP80 PL/0 }
{ ON A CLEAR CELL THE ANT TURNS RIGHT, ON A SET ONE LEFT; IT FLIPS THE }
{ CELL AND STEPS FORWARD.  AFTER ABOUT 10000 STEPS OF MUDDLE IT BUILDS A }
{ HIGHWAY AND WALKS OFF.  THE CELLS ARE QUARTER CHARACTERS ON LINES 2-31, }
{ 128 ACROSS, WITH Y FROM 4 TO 63 COUNTING FROM THE TOP OF LINE 0. }
{ A CELL IS TESTED WITH PEEK: ITS BIT M IN THE CHARACTER IS 1 TOP LEFT, }
{ 2 TOP RIGHT, 4 BOTTOM RIGHT AND 8 BOTTOM LEFT, AND A CHARACTER WITH NO }
{ QUARTERS IS POKED BACK AS A SPACE.  * AND / ARE SLOW, SO THE ANT KEEPS }
{ ITS CHARACTER'S ADDRESS A AS IT MOVES, AND TABLES AT 6656 GIVE THE BIT }
{ AND WHETHER IT IS SET: R IS 16 FOR AN ODD X PLUS 32 FOR AN ODD Y. }
{ IT STOPS WHEN THE ANT LEAVES THE SCREEN, AFTER 12024 STEPS AND ABOUT }
{ 13 S; A KEY THEN CLEARS IT.  A KEY WHILE IT RUNS STOPS IT AND CLEARS }
{ THE SCREEN. }
10 CONST SCR = 32768, TST = 6592, BIT = 6720;
20 VAR X, Y, D, A, M, B, C, G, N, J, R, P, Q, I, W;
{ NUM WRITES P IN 5 COLUMNS FROM ADDRESS Q }
30 PROCEDURE NUM;
40 BEGIN
50   I := 5;
60   WHILE I > 0 DO
70   BEGIN
80     I := I - 1; C := 48 + P - P / 10 * 10;
90     IF P = 0 THEN IF I < 4 THEN C := 32;
100    POKE Q + I, C; P := P / 10
110  END
120 END;
{ CH WRITES CHARACTER C AT Q; TXT WRITES THREE LETTERS PACKED IN W, }
{ 1024 * FIRST + 32 * SECOND + THIRD, WITH 0 FOR A SPACE }
130 PROCEDURE CH;
140 BEGIN IF C = 0 THEN C := 32; POKE Q, C; Q := Q + 1 END;
150 PROCEDURE TXT;
160 BEGIN
170   C := W / 1024; CALL CH; C := W / 32 - W / 1024 * 32; CALL CH;
180   C := W - W / 32 * 32; CALL CH
190 END;
200 PROCEDURE STEP;
210 BEGIN
220   R := 0; IF ODD X THEN R := 16; IF ODD Y THEN R := R + 32;
230   M := PEEK (BIT + R); C := PEEK A; IF C < 64 THEN C := 64;
240   B := PEEK (TST + R + C);
250   IF B = 1 THEN BEGIN D := D + 3; C := C - M END;
260   IF B = 0 THEN BEGIN D := D + 1; C := C + M END;
270   IF D > 3 THEN D := D - 4;
280   IF C = 64 THEN C := 32;
290   POKE A, C;
300   IF D = 0 THEN BEGIN Y := Y - 1; IF ODD Y THEN A := A - 64 END;
310   IF D = 1 THEN BEGIN X := X + 1; IF ODD X + 1 THEN A := A + 1 END;
320   IF D = 2 THEN BEGIN Y := Y + 1; IF ODD Y + 1 THEN A := A + 64 END;
330   IF D = 3 THEN BEGIN X := X - 1; IF ODD X THEN A := A - 1 END;
340   IF X < 0 THEN G := 0; IF X > 127 THEN G := 0;
350   IF Y < 4 THEN G := 0; IF Y > 63 THEN G := 0
360 END;
{ THE TABLES: THE BIT FOR EACH R, THEN FOR EACH R AND QUARTERS 0-15 }
{ 1 IF THAT BIT IS SET }
370 PROCEDURE TABLES;
380 BEGIN
390   POKE BIT, 1; POKE BIT + 16, 2; POKE BIT + 32, 8; POKE BIT + 48, 4;
400   I := 0;
410   WHILE I < 64 DO
420   BEGIN
425     R := I / 16 * 16; B := 0;
430     IF ODD (I - R) / PEEK (BIT + R) THEN B := 1;
440     POKE TST + 64 + I, B; I := I + 1
450   END
460 END;
470 BEGIN
480   CLS; CALL TABLES; Q := SCR + 64;
490   W := 12334; CALL TXT; W := 7823; CALL TXT; C := 14; CALL CH;
500   C := 39; CALL CH; W := 19457; CALL TXT; W := 14976; CALL TXT;
510   Q := SCR + 85; W := 20101; CALL TXT; W := 16384; CALL TXT;
520   X := 90; Y := 28; D := 0; A := SCR + 14 * 64 + 45;
530   N := 0; J := 0; G := 1;
540   WHILE G = 1 DO
550   BEGIN
560     CALL STEP; N := N + 1; J := J + 1;
570     IF J = 100 THEN
580     BEGIN
590       J := 0; P := N; Q := SCR + 90; CALL NUM;
600       IF KEY # 0 THEN G := 2
610     END
620   END;
630   P := N; Q := SCR + 90; CALL NUM;
640   IF G = 0 THEN WHILE KEY = 0 DO;
650   CLS
660 END.
