{ BOUNCING BALLS IN COMP80 PL/0 }
{ SIX BALLS BOUNCE UNDER GRAVITY UNTIL A KEY IS PRESSED. A BALL IS }
{ 2 BY 2 POINTS, EACH FLIPPED WITH XOR, SO THAT DRAWING A BALL AGAIN }
{ RUBS IT OUT AND BALLS PASS THROUGH EACH OTHER. }
{ * AND / ARE SLOW, SO THE PROGRAM LOOKS THINGS UP INSTEAD. THE }
{ VARIABLES ARE TWO BYTES EACH FROM 7168 ON, IN THE ORDER DECLARED: }
{ BX BY VX VY, THEN X Y AND A, SO PEEK 7177 IS THE HIGH BYTE OF X. }
{ A BALL'S FOUR NUMBERS ARE KEPT IN 8 BYTES AT BT AND COPIED INTO }
{ BX BY VX VY AND BACK. POSITIONS AND SPEEDS ARE IN 256THS OF A }
{ POINT, SO THE HIGH BYTE OF A POSITION IS ITS POINT. }
10 CONST N=6, XT=6624, LT=6848, HT=6910, HF=6972, BT=7100;
20 VAR BX, BY, VX, VY, X, Y, A, I, J, K, M, Q, R, S, P, V, HI, KS;
30 PROCEDURE RND;
40  BEGIN S := S*31421+6927; R := S/128; IF R < 0 THEN R := R+256;
50   R := R*M/256 END;
{ PIX FLIPS THE POINT AT X Y. LT AND HT HOLD THE LOW AND HIGH BYTES }
{ OF THE ADDRESS OF THE LINE FOR EACH Y, HF HALF OF EACH X. K PICKS }
{ THE QUARTER: XT + K + 32 HOLDS THE CHARACTER FOR A SPACE WITH IT }
{ SET, AND XT + K + 64 + Q FOR QUARTERS Q WITH IT FLIPPED. }
60 PROCEDURE PIX;
70  BEGIN POKE 7180, PEEK (LT+PEEK 7179)+PEEK (HF+PEEK 7177);
80   POKE 7181, PEEK (HT+PEEK 7179);
90   K := 0; IF ODD PEEK 7177 THEN K := 48;
100  IF ODD PEEK 7179 THEN K := 144-K;
110  POKE A, PEEK (XT+K+PEEK A) END;
120 PROCEDURE BALL;
130  BEGIN X := BX; Y := BY; CALL PIX; X := X+256; CALL PIX;
140   Y := Y+256; CALL PIX; X := BX; CALL PIX END;
{ GET COPIES THE BALL AT J INTO BX BY VX VY, PUT COPIES IT BACK }
150 PROCEDURE GET;
160  BEGIN K := 0;
170   WHILE K < 8 DO BEGIN POKE 7168+K, PEEK (J+K); K := K+1 END END;
180 PROCEDURE PUT;
190  BEGIN K := 0;
200   WHILE K < 8 DO BEGIN POKE J+K, PEEK (7168+K); K := K+1 END END;
{ AXIS ADDS V TO P, BOUNCING OFF 0 AND HI }
210 PROCEDURE AXIS;
220  BEGIN P := P+V;
230   IF P > HI THEN BEGIN P := HI+HI-P; V := -V END;
240   IF P < 0 THEN BEGIN P := -P; V := -V END
250  END;
{ EACH STEP A BALL FALLS A LITTLE FASTER: GRAVITY }
260 PROCEDURE STEP;
270  BEGIN CALL GET; CALL BALL; VY := VY+32;
280   P := BX; V := VX; HI := 32255; CALL AXIS; BX := P; VX := V;
290   P := BY; V := VY; HI := 15615; CALL AXIS; BY := P; VY := V;
300   CALL BALL; CALL PUT
310  END;
320 PROCEDURE START;
330  BEGIN M := 125; CALL RND; BX := R*256; M := 28; CALL RND;
340   BY := R*256; M := 64; CALL RND; VX := R*3+192;
350   M := 2; CALL RND; IF R = 1 THEN VX := -VX;
360   M := 64; CALL RND; VY := R*8-256; CALL BALL; CALL PUT
370  END;
380 BEGIN
{ FLIPPING BIT M OF Q ADDS M OR TAKES IT AWAY }
390  M := 1; P := XT+32;
400  WHILE M < 16 DO BEGIN POKE P, M+64; Q := 0;
410   WHILE Q < 16 DO BEGIN R := Q+M; IF ODD Q/M THEN R := Q-M;
420    IF R = 0 THEN R := -32; POKE P+32+Q, R+64; Q := Q+1 END;
430   P := P+48; M := M+M END;
440  I := 0;
450  WHILE I < 128 DO BEGIN POKE HF+I, I/2;
460   IF I < 62 THEN BEGIN A := 32768+I/2*64+64;
470    POKE LT+I, PEEK 7180; POKE HT+I, PEEK 7181 END;
480   I := I+1 END;
490  CLS; I := 0; J := BT;
500  WHILE I < N DO BEGIN CALL START; I := I+1; J := J+8 END;
510  KS := 0;
520  WHILE KS = 0 DO BEGIN I := 0; J := BT;
530   WHILE I < N DO BEGIN CALL STEP; IF ODD I THEN KS := KEY+KS;
540    I := I+1; J := J+8 END
550  END;
560  CLS
570 END.
