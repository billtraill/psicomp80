{ CHAOS GAME IN COMP80 PL/0 }
{ A POINT MOVES HALF WAY TO A CORNER OF A TRIANGLE PICKED AT }
{ RANDOM, 6000 TIMES, AND A SIERPINSKI TRIANGLE APPEARS. A KEY }
{ AT THE END CLEARS THE SCREEN. }
10 VAR S, R, X, Y, N;
{ RANDOM 0-255: BITS 7-14 OF A 16-BIT LCG }
20 PROCEDURE RND;
30 BEGIN
40   S := S * 31421 + 6927; R := S;
50   IF R < 0 THEN R := R + 32767 + 1;
60   R := R / 128
70 END;
80 BEGIN
90   CLS; X := 64; Y := 30; N := 0;
100  WHILE N < 6000 DO
110  BEGIN
120    CALL RND;
{ THE CORNERS ARE 64,0 AND 1,61 AND 126,61 }
130    IF R < 85 THEN BEGIN X := (X + 64) / 2; Y := Y / 2 END;
140    IF R >= 85 THEN BEGIN Y := (Y + 61) / 2;
150      IF R < 170 THEN X := (X + 1) / 2;
160      IF R >= 170 THEN X := (X + 126) / 2
170    END;
180    PLOT X, Y; N := N + 1
190  END;
200  WHILE KEY = 0 DO;
210  CLS
220 END.
