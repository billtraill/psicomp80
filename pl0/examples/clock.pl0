{ A BIG DIGITAL CLOCK IN COMP80 PL/0 }
{ ASKS FOR THE HOURS, MINUTES AND SECONDS AND RUNS THE CLOCK FROM }
{ THEN; ANY KEY STOPS IT. }
{ THE DIGITS ARE 3 BY 5 DOTS, A BIT EACH FROM THE TOP LEFT, IN F; }
{ THEN A COLON AND A BLANK. A DOT IS 4 QUARTERS ACROSS AND 3 DOWN, }
{ SO A DIGIT IS 6 CHARACTERS BY 8 LINES, STARTING HALF A LINE DOWN, }
{ AND BOTH CHARACTERS OF A DOT'S COLUMN ARE THE SAME. EACH GLYPH IS }
{ WORKED OUT ONCE, INTO 24 BYTES AT IM: 8 LINES OF 3 CHARACTERS. }
10 CONST IM=6656, D=6944;
20 VAR H, M, S, N, C, F, P, I, L, T, B, A, W, R, K;
{ MK UNPACKS F INTO D, A BYTE A DOT, THEN WORKS OUT GLYPH N }
30 PROCEDURE MK;
40  BEGIN P := 16384; I := 0;
50   WHILE I < 15 DO BEGIN T := 0; IF ODD F/P THEN T := 1; POKE D+I, T;
60    P := P/2; I := I+1 END;
70   A := IM+N*24; L := 0;
80   WHILE L < 8 DO BEGIN I := 0;
90    WHILE I < 3 DO BEGIN T := 0; IF L > 0 THEN T := PEEK (D+(L+L-1)/3*3+I);
100     B := PEEK (D+(L+L)/3*3+I); T := T*3+B*12; IF T = 0 THEN T := -32;
110     POKE A, T+64; A := A+1; I := I+1 END;
120    L := L+1 END;
130  N := N+1 END;
{ SHOW COPIES GLYPH N TO COLUMN C OF LINES 12-19 }
140 PROCEDURE SHOW;
150  BEGIN P := IM+N*24; A := 33536+C; L := 0;
160   WHILE L < 8 DO BEGIN T := PEEK P; POKE A, T; POKE A+1, T;
170    T := PEEK (P+1); POKE A+2, T; POKE A+3, T; T := PEEK (P+2);
180    POKE A+4, T; POKE A+5, T; P := P+3; A := A+64; L := L+1 END END;
190 PROCEDURE TWO;
200  BEGIN N := W/10; CALL SHOW; N := W-N*10; C := C+7; CALL SHOW END;
{ THE COLONS ARE THERE IN EVEN SECONDS }
210 PROCEDURE DRAW;
220  BEGIN W := H; C := 4; CALL TWO; W := M; C := 25; CALL TWO;
230   W := S; C := 46; CALL TWO; N := 10; IF ODD S THEN N := 11;
240   C := 18; CALL SHOW; C := 39; CALL SHOW END;
250 PROCEDURE ONE;
260  BEGIN S := S+1; IF S = 60 THEN BEGIN S := 0; M := M+1 END;
270   IF M = 60 THEN BEGIN M := 0; H := H+1 END; IF H = 24 THEN H := 0 END;
280 BEGIN
290  ? H; ? M; ? S; CLS;
300  N := 0; F := 31599; CALL MK; F := 11415; CALL MK; F := 29671; CALL MK;
310  F := 29647; CALL MK; F := 23497; CALL MK; F := 31183; CALL MK;
320  F := 31215; CALL MK; F := 29257; CALL MK; F := 31727; CALL MK;
330  F := 31695; CALL MK; F := 1040; CALL MK; F := 0; CALL MK;
{ A SECOND IS DRAWING THE TIME AND 130 KEYS, AND ONE MORE WHEN R HAS }
{ ADDED UP TO 1000: SET BY TIMING THE EMULATOR }
340  K := 0;
350  WHILE K = 0 DO BEGIN CALL DRAW; I := 130;
360   WHILE I > 0 DO BEGIN K := KEY+K; I := I-1 END;
370   R := R+691; IF R >= 1000 THEN BEGIN R := R-1000; K := KEY+K END;
380   CALL ONE END;
390  CLS
400 END.
