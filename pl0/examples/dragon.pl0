{ DRAGON CURVE IN COMP80 PL/0 }
{ FOLD A STRIP OF PAPER IN HALF 9 TIMES AND OPEN IT OUT: THE FOLDS }
{ TURN LEFT OR RIGHT.  AFTER STEP I IT TURNS LEFT WHEN THE BIT ABOVE }
{ THE LOWEST SET BIT OF I IS 0.  512 STEPS OF 4 POINTS ACROSS OR 2 DOWN }
{ WITH PLOT.  D IS THE DIRECTION: 0 EAST, 1 SOUTH, 2 WEST, 3 NORTH. }
{ W PUTS THE TITLE ON LINE 1, THREE LETTERS FROM EACH NUMBER IN BASE 32. }
{ ABOUT 2 S; THEN ANY KEY CLEARS IT. }
10 VAR X, Y, D, N, I, J, DX, DY, M;
20 PROCEDURE C;
30 BEGIN IF J = 0 THEN J := 32; POKE M, J; M := M + 1 END;
40 PROCEDURE W;
50 BEGIN
60   J := N / 1024; CALL C; J := N / 32 - N / 1024 * 32; CALL C;
70   J := N - N / 32 * 32; CALL C
80 END;
90 PROCEDURE FD;
100 BEGIN
110   N := 4; DX := 1 - D; DY := 0;
120   IF ODD D THEN BEGIN N := 2; DX := 0; DY := 2 - D END;
130   WHILE N > 0 DO
140   BEGIN X := X + DX; Y := Y + DY; PLOT X, Y; N := N - 1 END
150 END;
160 BEGIN
170   CLS; M := 32832;
180   N := 4673; CALL W; N := 7662; CALL W; N := 117; CALL W;
190   N := 19141; CALL W;
200   X := 86; Y := 14; D := 1; PLOT X, Y;
210   I := 1;
220   WHILE I <= 512 DO
230   BEGIN
240     CALL FD;
250     J := I; WHILE ODD J + 1 DO J := J / 2;
260     D := D + 1; IF ODD J / 2 THEN D := D + 2;
270     D := D - D / 4 * 4;
280     I := I + 1
290   END;
300   WHILE KEY = 0 DO;
310   CLS
320 END.
