{ FASTER SORTING, TO WATCH, IN COMP80 PL/0 }
{ THE SAME 64 RANDOM BARS AS SORT.PL0, SORTED BY SHELL SORT AND THEN }
{ QUICKSORT. EACH HAS A LINE AT THE TOP WITH ITS NAME, THEN HOW MANY }
{ COMPARISONS AND HOW MANY SWAPS IT MADE. A KEY AT THE END CLEARS THE }
{ SCREEN. TO LEAVE ROOM FOR ITS CODE IT IS PACKED, WITH SPACES ONLY }
{ WHERE THEY ARE NEEDED. }
{ BAR C IS COLUMN C, UP TO 56 HALF LINES TALL FROM LINE 31. THE }
{ HEIGHTS ARE BYTES AT V }
10 CONST V=6656,Q=6720,B=34752,TOP=32768;VAR S,N,T,P,U,C,W,R,K,F,CM,SW,XA,XB,XI
20 ,XJ,BC,BO,BN,LO,HI,A,D,I,J,M,G,L,H,PV,NX,QS;
{ A BAR GOING FROM HEIGHT BO TO BN: ONLY THE CELLS BETWEEN CHANGE. }
{ A CELL IS FULL (79), BOTTOM HALF (76) OR EMPTY (32) }
30 PROCEDURE BAR;BEGIN LO:=BO;HI:=BN;IF LO>HI THEN BEGIN LO:=BN;HI:=BO END;LO:=
40 LO/2;HI:=(HI+1)/2;A:=B+BC-LO*64;D:=LO+LO+1;WHILE LO<HI DO BEGIN C:=32;IF BN=
50 D THEN C:=76;IF BN>D THEN C:=79;POKE A,C;A:=A-64;D:=D+2;LO:=LO+1 END END;
{ PUT WRITES THREE LETTERS PACKED IN W AT P: 1024 TIMES THE FIRST, }
{ 32 TIMES THE SECOND AND THE THIRD, A=1 TO Z=26; 0 IS NOTHING }
60 PROCEDURE PUT;BEGIN N:=1024;WHILE N>0 DO BEGIN C:=W/N;W:=W-C*N;IF C>0 THEN
70 POKE P,C;P:=P+1;N:=N/32 END END;
{ U IN FOUR DIGITS, THE LAST AT P }
80 PROCEDURE NUM;BEGIN N:=0;WHILE N<4 DO BEGIN T:=U/10;POKE P,U-T*10+48;P:=P-1;
90 U:=T;N:=N+1 END END;
{ THE COUNTS OF THE SORT ON LINE K }
100 PROCEDURE COUNT;BEGIN P:=R+13;U:=CM;CALL NUM;P:=R+18;U:=SW;CALL NUM END;
110 PROCEDURE WAIT;BEGIN N:=0;WHILE N<150 DO BEGIN T:=KEY;N:=N+1 END END;
{ SWAP BARS XA AND XB, REDRAWING BOTH }
120 PROCEDURE XCH;BEGIN XI:=PEEK(V+XA);XJ:=PEEK(V+XB);POKE V+XA,XJ;POKE V+XB,XI
130 ;BC:=XA;BO:=XI;BN:=XJ;CALL BAR;BC:=XB;BO:=XJ;BN:=XI;CALL BAR;SW:=SW+1;CALL
140 COUNT END;
{ COMPARE BARS XA AND XB AND SWAP THEM IF THE LEFT ONE IS TALLER; }
{ F IS 1 IF THEY WERE SWAPPED }
150 PROCEDURE GT;BEGIN CM:=CM+1;F:=0;IF PEEK(V+XA)>PEEK(V+XB)THEN BEGIN CALL
160 XCH;F:=1 END END;
{ THE SAME 64 BARS EACH TIME, AS THE SEED STARTS THE SAME; THEN A }
{ PAUSE }
170 PROCEDURE FILL;BEGIN S:=1979;BC:=0;CM:=0;SW:=0;CALL COUNT;WHILE BC<64 DO
180 BEGIN S:=S*31421+6927;BO:=0;IF K>1 THEN BO:=PEEK(V+BC);BN:=(S/512+64)*7/16+
190 1;CALL BAR;POKE V+BC,BN;BC:=BC+1 END;CALL WAIT END;
{ SHELL SORT: EACH BAR IN TURN MOVES LEFT, G PLACES AT A TIME, UNTIL }
{ THE ONE G BEFORE IT IS NO TALLER, WITH G FROM 32 HALVING DOWN TO 1. }
{ THE LAST STEP, G = 1, IS INSERTION SORT, BUT BY THEN EACH BAR IS NEAR }
{ ITS PLACE, SO IT HAS LITTLE TO DO }
200 PROCEDURE SHELL;BEGIN WHILE G>0 DO BEGIN I:=G;WHILE I<64 DO BEGIN J:=I;
210 WHILE J>=G DO BEGIN XA:=J-G;XB:=J;CALL GT;J:=J-G;IF F=0 THEN J:=0 END;I:=I+
220 1 END;G:=G/2 END END;
{ QUICKSORT: THE BARS SHORTER THAN THE LAST ONE GO TO THE LEFT, IT }
{ GOES NEXT TO THEM, AND EACH SIDE IS SORTED IN THE SAME WAY. THE SIDES }
{ STILL TO DO ARE KEPT AT Q AS PAIRS OF BYTES, ONE MORE THAN THE ENDS }
230 PROCEDURE QUICK;BEGIN POKE Q,1;POKE Q+1,64;QS:=2;WHILE QS>0 DO BEGIN QS:=QS
240 -2;L:=PEEK(Q+QS)-1;H:=PEEK(Q+QS+1)-1;IF L<H THEN BEGIN PV:=PEEK(V+H);NX:=L;
250 I:=L;WHILE I<H DO BEGIN CM:=CM+1;IF PEEK(V+I)<PV THEN BEGIN XA:=NX;XB:=I;IF
260 NX#I THEN CALL XCH;NX:=NX+1 END;I:=I+1 END;XA:=NX;XB:=H;IF NX#H THEN CALL
270 XCH;POKE Q+QS,NX+2;POKE Q+QS+1,H+1;POKE Q+QS+2,L+1;POKE Q+QS+3,NX;QS:=QS+4
280 END END END;
{ EACH SORT IN TURN: ITS NAME ON LINE K, THE BARS, AND THE SORT }
290 BEGIN CLS;K:=1;R:=TOP+64;P:=R;W:=19717;CALL PUT;W:=12672;CALL PUT;CALL FILL
300 ;G:=32;CALL SHELL;CALL COUNT;CALL WAIT;K:=2;R:=TOP+128;P:=R;W:=18089;CALL
310 PUT;W:=3424;CALL PUT;CALL FILL;CALL QUICK;CALL COUNT;CALL WAIT;WHILE KEY=0
320 DO;CLS END.
