{ BARNSLEY FERN IN COMP80 PL/0 }
{ PLOTS 5000 POINTS: EACH IS THE LAST ONE MOVED BY ONE OF FOUR }
{ SHRINKING MAPS, PICKED AT RANDOM, AND THE POINTS FILL IN A FERN. }
{ THE FERN IS IN WHOLE NUMBERS, WITH 36 AS 1.0 AND THE MAPS IN }
{ HUNDREDTHS. A KEY AT THE END CLEARS THE SCREEN. }
10 VAR S, R, X, Y, T, N;
{ RANDOM 0-255: BITS 7-14 OF A 16-BIT LCG }
20 PROCEDURE RND;
30 BEGIN
40   S := S * 31421 + 6927; R := S;
50   IF R < 0 THEN R := R + 32767 + 1;
60   R := R / 128
70 END;
{ ONE STEP: MAPS 1-4 PICKED 3, 218, 18 AND 17 TIMES IN 256 }
80 PROCEDURE STEP;
90 BEGIN
100  CALL RND;
110  IF R < 3 THEN BEGIN X := 0; Y := Y * 16 / 100 END;
120  IF R >= 3 THEN IF R < 221 THEN
130  BEGIN T := (X * 85 + Y * 4) / 100; Y := (Y * 85 - X * 4) / 100 + 58 END;
140  IF R >= 221 THEN IF R < 239 THEN
150  BEGIN T := (X * 20 - Y * 26) / 100; Y := (X * 23 + Y * 22) / 100 + 58 END;
160  IF R >= 239 THEN
170  BEGIN T := (Y * 28 - X * 15) / 100; Y := (X * 26 + Y * 24) / 100 + 16 END;
180  IF R >= 3 THEN X := T
190 END;
200 BEGIN
210  CLS; X := 0; Y := 0; N := 0;
220  WHILE N < 20 DO BEGIN CALL STEP; N := N + 1 END;
230  N := 0;
240  WHILE N < 5000 DO
250  BEGIN
260    CALL STEP; PLOT X / 3 + 62, 61 - Y / 6; N := N + 1
270  END;
280  WHILE KEY = 0 DO;
290  CLS
300 END.
