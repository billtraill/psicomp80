{ TOWERS OF HANOI IN COMP80 PL/0, ANIMATED }
{ MOVES N DISCS FROM THE LEFT PEG TO THE RIGHT: EACH DISC LIFTS }
{ OFF, SLIDES ACROSS AND DROPS ON AGAIN. ANY KEY STOPS IT; AT THE }
{ END A KEY CLEARS THE SCREEN. IT IS WRITTEN WITHOUT SPACES ROUND THE }
{ SIGNS TO LEAVE ROOM FOR ITS CODE. }
10 CONST N=6,FLOOR=28,HT=6656;
20 VAR TOP,LIFT,MOVES,STOP,K,X,Y,DX,DY,D,F,T,A,C,I,W;
{ THREE LETTERS PACKED IN W AS 729 * A + 27 * B + C, PUT AT A }
{ A SPACE IS 0 }
30 PROCEDURE PUT;
40 BEGIN IF C=0 THEN C:=32; POKE A,C; A:=A+1 END;
50 PROCEDURE WRD;
60 BEGIN
70  C:=W/729; W:=W-C*729; CALL PUT;
80  C:=W/27; W:=W-C*27; CALL PUT; C:=W; CALL PUT
90 END;
{ A PEG: RIGHT HALF OF ONE CHARACTER, LEFT HALF OF THE NEXT }
100 PROCEDURE POST;
110 BEGIN A:=32768+Y*64+X; POKE A-1,70; POKE A,73 END;
{ DISC K IS 2K LOWER HALF BLOCKS, CENTRED ON X }
120 PROCEDURE ROW;
130 BEGIN
140  A:=32768+Y*64+X-K; I:=0;
150  WHILE I<K+K DO BEGIN POKE A+I,C; I:=I+1 END
160 END;
{ MOVE THE DISC A STEP, THEN WAIT, WATCHING FOR A KEY. ONCE ONE IS }
{ PRESSED THE DISC FINISHES ITS MOVE AT ONCE AND HAN STOPS }
170 PROCEDURE STEP;
180 BEGIN
190  C:=32; CALL ROW; IF Y>=TOP THEN CALL POST;
200  X:=X+DX; Y:=Y+DY; C:=76; CALL ROW;
210  I:=STOP*4; WHILE I<4 DO BEGIN IF KEY#0 THEN STOP:=1; I:=I+1 END
220 END;
{ MOVE DISC K, THE TOP ONE ON PEG F, ONTO PEG T }
230 PROCEDURE MOVE;
240 BEGIN
250  X:=F*21+11; Y:=FLOOR-PEEK(HT+F);
260  POKE HT+F,PEEK(HT+F)-1;
270  DX:=0; DY:=-1; WHILE Y>LIFT DO CALL STEP;
280  D:=T*21+11; DY:=0; DX:=1; IF D<X THEN DX:=-1;
290  WHILE X#D DO CALL STEP;
300  POKE HT+T,PEEK(HT+T)+1; D:=FLOOR-PEEK(HT+T);
310  DX:=0; DY:=1; WHILE Y<D DO CALL STEP;
320  MOVES:=MOVES+1; A:=32768+3*64+29;
330  IF MOVES<10 THEN POKE A,MOVES+48;
340  IF MOVES>=10 THEN BEGIN POKE A,MOVES/10+48;
350   POKE A+1,MOVES-MOVES/10*10+48 END
360 END;
{ K - 1 DISCS OUT OF THE WAY TO THE THIRD PEG, 3 - F - T, DISC K }
{ ACROSS, AND K - 1 BACK ON TOP. HAN LEAVES K, F AND T AS THEY WERE }
370 PROCEDURE HAN;
380 BEGIN
390  IF K>0 THEN IF STOP=0 THEN
400  BEGIN
410   K:=K-1; T:=3-F-T; CALL HAN; T:=3-F-T; K:=K+1;
420   IF STOP=0 THEN CALL MOVE;
430   K:=K-1; F:=3-F-T; CALL HAN; F:=3-F-T; K:=K+1
440  END
450 END;
460 BEGIN
470  CLS; MOVES:=0; STOP:=0; TOP:=FLOOR-N-1; LIFT:=TOP-2;
480  A:=32768+64+21; W:=15008; CALL WRD; W:=4150; CALL WRD;
490  W:=411; CALL WRD; W:=217; CALL WRD; W:=10620; CALL WRD;
500  A:=32768+3*64+23; W:=9904; CALL WRD; W:=4158; CALL WRD;
510  POKE A,48;
520  A:=32768+FLOOR*64; X:=0;
530  WHILE X<64 DO BEGIN POKE A+X,67; X:=X+1 END;
540  Y:=TOP;
550  WHILE Y<FLOOR DO
560  BEGIN
570   X:=11; WHILE X<60 DO BEGIN CALL POST; X:=X+21 END;
580   Y:=Y+1
590  END;
600  POKE HT,N; POKE HT+1,0; POKE HT+2,0; X:=11; C:=76; K:=N;
610  WHILE K>0 DO BEGIN Y:=FLOOR-1-N+K; CALL ROW; K:=K-1 END;
620  K:=N; F:=0; T:=2; CALL HAN;
630  IF STOP=0 THEN WHILE KEY=0 DO;
640  CLS
650 END.
