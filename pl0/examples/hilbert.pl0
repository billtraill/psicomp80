{ HILBERT CURVE IN COMP80 PL/0 }
{ A TURTLE DRAWS IT: EACH LEVEL IS FOUR CURVES OF THE LEVEL BELOW, }
{ TURNED AND JOINED BY THREE STEPS.  LEVEL 5 IS 32 X 32 POINTS, 4 CELLS }
{ APART ACROSS AND 2 DOWN, OVER THE WHOLE SCREEN, TITLE LINE TOO, SO IT }
{ SETS THE CELLS ITSELF WITH PEEK AND POKE: 128 X 64, FOUR TO A }
{ CHARACTER.  Q IS THE CHARACTER THE TURTLE IS IN AND HX, HY WHICH }
{ QUARTER, SO A STEP NEEDS NO * OR /, WHICH ARE SLOW.  P SETS THAT }
{ QUARTER.  HIL CALLS ITSELF; L AND A ARE SHARED, SO IT PUTS THEM BACK. }
{ D IS THE DIRECTION: 0 EAST, 1 SOUTH, 2 WEST, 3 NORTH. }
{ ABOUT 2 S; THEN ANY KEY CLEARS IT AND PUTS THE TITLE LINE BACK. }
10 VAR D, L, A, T, N, DX, DY, HX, HY, B, Q, E, I;
20 PROCEDURE P;
30 BEGIN
40   B := 1 + HX; IF HY = 1 THEN B := 8 - 4 * HX;
50   E := PEEK Q; IF E < 64 THEN E := 64; POKE Q, E + B
60 END;
70 PROCEDURE FD;
80 BEGIN
90   N := 4; DX := 1 - D; DY := 0;
100   IF ODD D THEN BEGIN N := 2; DX := 0; DY := 2 - D END;
110   WHILE N > 0 DO
120   BEGIN
130     HX := HX + DX; HY := HY + DY;
140     IF HX = 2 THEN BEGIN HX := 0; Q := Q + 1 END;
150     IF HX < 0 THEN BEGIN HX := 1; Q := Q - 1 END;
160     IF HY = 2 THEN BEGIN HY := 0; Q := Q + 64 END;
170     IF HY < 0 THEN BEGIN HY := 1; Q := Q - 64 END;
180     CALL P; N := N - 1
190   END
200 END;
210 PROCEDURE TURN;
220 BEGIN D := D + T; IF D < 0 THEN D := 3; IF D > 3 THEN D := 0 END;
230 PROCEDURE HIL;
240 BEGIN
250   IF L > 0 THEN
260   BEGIN
270     T := A; CALL TURN; L := L - 1;
280     A := -A; CALL HIL; CALL FD; T := A; CALL TURN;
290     A := -A; CALL HIL; CALL FD; CALL HIL; T := -A; CALL TURN; CALL FD;
300     A := -A; CALL HIL; A := -A;
310     L := L + 1; T := A; CALL TURN
320   END
330 END;
340 BEGIN
350   I := 0;
360   WHILE I < 64 DO BEGIN POKE 6656 + I, PEEK (32768 + I); I := I + 1 END;
370   I := 0;
380   WHILE I < 2048 DO BEGIN POKE 32768 + I, 32; I := I + 1 END;
390   Q := 32768 + 31 * 64; HX := 1; HY := 0; D := 0; CALL P;
400   L := 5; A := -1; CALL HIL;
410   WHILE KEY = 0 DO;
420   CLS; I := 0;
430   WHILE I < 64 DO BEGIN POKE 32768 + I, PEEK (6656 + I); I := I + 1 END
440 END.
