{ KOCH SNOWFLAKE IN COMP80 PL/0 }
{ EACH SIDE OF A TRIANGLE BECOMES FOUR, A THIRD AS LONG, WITH A POINT }
{ IN THE MIDDLE, AND SO ON, 3 TIMES.  SIX DIRECTIONS, 60 DEGREES APART: }
{ D 0 IS UP 2 POINTS, 1 IS 3 ACROSS AND 1 UP, AND SO ON CLOCKWISE; }
{ 3 ACROSS AND 1 UP OR DOWN IS NEARLY THE SAME LENGTH AS 2 UP. }
{ SIDE CALLS ITSELF; N IS SHARED, SO IT TAKES N DOWN AND PUTS IT BACK. }
{ W PUTS THE TITLE ON LINE 1, THREE LETTERS FROM EACH NUMBER IN BASE 32. }
{ ABOUT 1 S; THEN ANY KEY CLEARS IT. }
10 VAR X, Y, D, N, T, E, I, J, DX, DY, M;
20 PROCEDURE C;
30 BEGIN IF J = 0 THEN J := 32; POKE M, J; M := M + 1 END;
40 PROCEDURE W;
50 BEGIN
60   J := N / 1024; CALL C; J := N / 32 - N / 1024 * 32; CALL C;
70   J := N - N / 32 * 32; CALL C
80 END;
90 PROCEDURE FD;
100 BEGIN
110   E := D - D / 3 * 3;
120   IF E = 0 THEN
130   BEGIN
140     DY := D / 3 * 2 - 1;
150     Y := Y + DY; PLOT X, Y; Y := Y + DY; PLOT X, Y
160   END;
170   IF E > 0 THEN
180   BEGIN
190     DX := 1; IF D > 3 THEN DX := -1; DY := (2 * E - 3) * DX;
200     X := X + DX; PLOT X, Y; X := X + DX; Y := Y + DY; PLOT X, Y;
210     X := X + DX; PLOT X, Y
220   END
230 END;
240 PROCEDURE TURN;
250 BEGIN D := D + T + 6; D := D - D / 6 * 6 END;
260 PROCEDURE SIDE;
270 BEGIN
280   IF N = 0 THEN CALL FD;
290   IF N > 0 THEN
300   BEGIN
310     N := N - 1;
320     CALL SIDE; T := -1; CALL TURN; CALL SIDE; T := 2; CALL TURN;
330     CALL SIDE; T := -1; CALL TURN; CALL SIDE;
340     N := N + 1
350   END
360 END;
370 BEGIN
380   CLS; M := 32832;
390   N := 11747; CALL W; N := 8211; CALL W; N := 14839; CALL W;
400   N := 6529; CALL W; N := 11424; CALL W;
410   X := 37; Y := 58; D := 0; PLOT X, Y;
420   I := 0;
430   WHILE I < 3 DO
440   BEGIN N := 3; CALL SIDE; T := 2; CALL TURN; I := I + 1 END;
450   WHILE KEY = 0 DO;
460   CLS
470 END.
