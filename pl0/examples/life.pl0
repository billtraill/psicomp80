{ GAME OF LIFE IN COMP80 PL/0 }
{ 64 X 31 CELLS ON SCREEN LINES 1-31, ONE PER CHARACTER, READ STRAIGHT }
{ FROM SCREEN MEMORY WITH PEEK; THE EDGES WRAP.  IT STARTS FROM A RANDOM }
{ BOARD AND RUNS UNTIL A KEY IS PRESSED, COUNTING GENERATIONS ON LINE 0. }
{ A LIVE CELL IS 79 (A SOLID BLOCK) AND A DEAD ONE 32, SO THE NINE CELLS }
{ OF A 3X3 SQUARE ADD UP TO 288 + 47 FOR EACH LIVE ONE: 429 (3 LIVE) }
{ MEANS ALIVE, 476 (4 LIVE) MEANS NO CHANGE, ANYTHING ELSE DEAD.  EACH ROW }
{ FIRST ADDS UP ITS COLUMNS OF THREE INTO SUM, THEN WRITES THE NEW ROW }
{ BACK, KEEPING THE OLD ONE IN PRV FOR THE ROW BELOW.  ABOUT 1 S A }
{ GENERATION.  IT LOOKS FOR A KEY EVERY FOURTH ROW, AND A KEY STOPS IT AT }
{ THE END OF THAT GENERATION AND CLEARS THE SCREEN. }
10 CONST SCR = 32832, SUM = 6656, PRV = 6784, R0 = 6912;
20 VAR S, X, Y, U, M, D, T, C, O, K, N, P, Q, I;
{ NUM WRITES P IN 5 COLUMNS FROM ADDRESS Q }
30 PROCEDURE NUM;
40 BEGIN
50   I := 5;
60   WHILE I > 0 DO
70   BEGIN
80     I := I - 1; C := 48 + P - P / 10 * 10;
90     IF P = 0 THEN IF I < 4 THEN C := 32;
100    POKE Q + I, C; P := P / 10
110  END
120 END;
130 PROCEDURE GEN;
140 BEGIN
150   X := 0;
160   WHILE X < 64 DO BEGIN POKE R0 + X, PEEK (SCR + X); X := X + 1 END;
170   U := SCR + 1920; Y := 0;
180   WHILE Y < 31 DO
190   BEGIN
200     M := SCR + 64 * Y; D := M + 64;
210     IF Y = 30 THEN D := R0;
220     X := 0;
230     WHILE X < 64 DO
240     BEGIN
250       POKE SUM + 1 + X, PEEK (U + X) + PEEK (M + X) + PEEK (D + X);
260       X := X + 1
270     END;
280     POKE SUM, PEEK (SUM + 64); POKE SUM + 65, PEEK (SUM + 1);
290     X := 0;
300     WHILE X < 64 DO
310     BEGIN
320       O := PEEK (M + X); POKE PRV + X, O;
330       T := PEEK (SUM + X) + PEEK (SUM + X + 1) + PEEK (SUM + X + 2);
340       C := 32;
350       IF T = 476 THEN C := O;
360       IF T = 429 THEN C := 79;
370       POKE M + X, C; X := X + 1
380     END;
390     U := PRV; Y := Y + 1;
395     IF Y / 4 * 4 = Y THEN IF K = 0 THEN K := KEY
400   END
410 END;
420 BEGIN
430   CLS; S := 1979; X := 0;
440   WHILE X < 1984 DO
450   BEGIN
460     S := S * 31421 + 6927; C := 32;
470     IF S < 0 THEN C := 79;
480     POKE SCR + X, C; X := X + 1
490   END;
500   POKE 32818, 7; POKE 32819, 5; POKE 32820, 14;
510   N := 0; K := 0;
520   WHILE K = 0 DO
530   BEGIN
540     N := N + 1; P := N; Q := 32822; CALL NUM;
550     CALL GEN
560   END;
570   X := 0;
580   WHILE X < 9 DO BEGIN POKE 32818 + X, 32; X := X + 1 END;
590   CLS
600 END.
