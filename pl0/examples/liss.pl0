{ LISSAJOUS AND SPIROGRAPH CURVES IN COMP80 PL/0 }
{ FIRST X = SIN 3T AGAINST Y = SIN 2T, THEN A SMALL WHEEL GOING ROUND A }
{ BIG ONE 5 TIMES AS FAST.  A KEY GOES FROM ONE TO THE NEXT AND CLEARS. }
{ 256 STEPS TO A TURN.  THE SINE OF HALF A TURN, 127 SIN, GOES IN BYTES }
{ AT 7040.  D UNPACKS IT FROM THE STEPS UP A QUARTER TURN, 0 TO 4, SIX }
{ OF THEM TO EACH NUMBER IN BASE 5; THE SECOND QUARTER IS THE FIRST }
{ BACKWARDS.  MAKE SCALES IT BY AM INTO A TABLE AT TB, SO DRAWING }
{ DOESN'T MULTIPLY OR DIVIDE: THEY ARE SLOW. }
{ G LOOKS UP STEP J OF TABLE TB IN U, THE SECOND HALF TURN NEGATIVE. }
{ THE TWO ANGLES P AND R GO ROUND IN QUARTER STEPS, 1024 POINTS FOR }
{ EACH CURVE: STEP MOVES P (PJ STEPS AND PF QUARTERS) ON BY DP, AND R }
{ (RJ AND RF) BY DR. }
{ W PUTS A TITLE ON LINE 1, THREE CHARACTERS FROM EACH NUMBER IN BASE 32: }
{ 1-26 ARE A-Z AND 27-31 THE DIGITS 1-5.  ABOUT 1.5 S FOR EACH CURVE. }
{ IT IS WRITTEN WITHOUT SPACES ROUND THE SIGNS SO THAT THE TEXT AND THE }
{ CODE FIT IN MEMORY TOGETHER. }
10 CONST T1=6656,T2=6784,T3=6912,SN=7040;
20 VAR I,J,K,U,X,Y,N,M,TB,AM,DP,DR,PJ,PF,RJ,RF;
30 PROCEDURE C;
40 BEGIN
50   IF J>26 THEN J:=J+22; IF J=0 THEN J:=32;
60   POKE M,J; M:=M+1
70 END;
80 PROCEDURE W;
90 BEGIN
100   J:=N/1024; CALL C; J:=N/32-N/1024*32; CALL C;
110   J:=N-N/32*32; CALL C
120 END;
130 PROCEDURE MAKE;
140 BEGIN
150   I:=0;
160   WHILE I<128 DO
170   BEGIN POKE TB+I,AM*PEEK (SN+I)/127; I:=I+1 END
180 END;
190 PROCEDURE G;
200 BEGIN
210   IF J>255 THEN J:=J-256;
220   IF J<128 THEN U:=PEEK (TB+J);
230   IF J>127 THEN U:=-PEEK (TB+J-128)
240 END;
250 PROCEDURE STEP;
260 BEGIN
270   PF:=PF+DP; WHILE PF>3 DO BEGIN PF:=PF-4; PJ:=PJ+1 END;
280   IF PJ>255 THEN PJ:=PJ-256;
290   RF:=RF+DR; WHILE RF>3 DO BEGIN RF:=RF-4; RJ:=RJ+1 END;
300   IF RJ>255 THEN RJ:=RJ-256
310 END;
320 PROCEDURE START;
330 BEGIN CLS; M:=32832; PJ:=0; PF:=0; RF:=0 END;
340 PROCEDURE D;
350 BEGIN
360   J:=0;
370   WHILE J<6 DO
380   BEGIN
390     U:=U+N-N/5*5; N:=N/5; K:=K+1; POKE SN+K,U;
400     J:=J+1
410   END
420 END;
430 BEGIN
440   POKE SN,0; U:=0; K:=0;
450   N:=12343; CALL D; N:=11718; CALL D; N:=11093; CALL D;
460   N:=11593; CALL D; N:=7942; CALL D; N:=7813; CALL D;
470   N:=7187; CALL D; N:=4032; CALL D; N:=3286; CALL D;
480   N:=131; CALL D; N:=1; CALL D; I:=65;
490   WHILE I<128 DO BEGIN POKE SN+I,PEEK (SN+128-I); I:=I+1 END;
500   CALL START;
510   N:=12595; CALL W; N:=19498; CALL W; N:=16051; CALL W;
520   N:=928; CALL W; N:=20960; CALL W; N:=28672; CALL W;
530   TB:=T1; AM:=63; CALL MAKE; TB:=T2; AM:=29; CALL MAKE;
540   RJ:=32; DP:=3; DR:=2; I:=0;
550   WHILE I<1024 DO
560   BEGIN
570     TB:=T1; J:=PJ; CALL G; X:=64+U;
580     TB:=T2; J:=RJ; CALL G; PLOT X,32+U;
590     CALL STEP; I:=I+1
600   END;
610   WHILE KEY=0 DO;
620   CALL START;
630   N:=19977; CALL W; N:=18919; CALL W; N:=18480; CALL W;
640   N:=8223; CALL W;
650   TB:=T1; AM:=30; CALL MAKE; TB:=T2; AM:=18; CALL MAKE;
660   TB:=T3; AM:=11; CALL MAKE;
670   RJ:=0; DP:=1; DR:=5; I:=0;
680   WHILE I<1024 DO
690   BEGIN
700     TB:=T1; J:=PJ+64; CALL G; X:=64+U;
710     TB:=T2; J:=RJ+64; CALL G; X:=X+U;
720     J:=PJ; CALL G; Y:=32+U;
730     TB:=T3; J:=RJ; CALL G; PLOT X,Y+U;
740     CALL STEP; I:=I+1
750   END;
760   WHILE KEY=0 DO;
770   CLS
780 END.
