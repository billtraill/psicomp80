{ MANDELBROT SET IN COMP80 PL/0 }
{ ONE POINT PER CHARACTER ON LINES 1-31, SHADED BY HOW SOON IT ESCAPES. }
{ FIXED POINT: 90 IS 1.0, SO 2.0 SQUARED STILL FITS 16 BITS.  COLUMN 0-63 }
{ IS X FROM -2.0 TO 0.6 AND LINE 1-31 IS Y FROM -1.05 TO 1.05.  EACH STEP }
{ OF Z = Z*Z + C STOPS ONCE X OR Y IS 2 OR MORE (THEIR SQUARES WOULD NOT }
{ FIT) OR X*X + Y*Y IS OVER 4, OR AFTER 24 STEPS. }
{ * AND / ARE SLOW, SO A TABLE AT 6656 HOLDS A*A/90 FOR A FROM 0 TO 181, }
{ LESS 256 FROM 152 UP, WHERE IT NO LONGER FITS A BYTE.  THE SHADES FOR }
{ 1 TO 9 STEPS FOLLOW IT; 79, A SOLID BLOCK, IS THE SET ITSELF.  ABOUT }
{ 38 S, THEN DONE SHOWS ON LINE 0 AND A KEY CLEARS IT.  A KEY WHILE IT }
{ DRAWS STOPS IT AND CLEARS THE SCREEN. }
10 CONST S = 90, MAXIT = 24, SCR = 32832, SQ = 6656, PAL = 6847;
20 VAR X, Y, A, B, CX, CY, XX, YY, N, G, V, C, R;
30 BEGIN
40   CLS; A := 0;
50   WHILE A < 182 DO BEGIN POKE SQ + A, A * A / S; A := A + 1 END;
60   POKE PAL + 1, 32; POKE PAL + 2, 46; POKE PAL + 3, 58;
70   POKE PAL + 4, 45; POKE PAL + 5, 61; POKE PAL + 6, 43;
80   POKE PAL + 7, 42; POKE PAL + 8, 35; POKE PAL + 9, 37;
90   R := 0;
100  WHILE R < 31 DO
110  BEGIN
120    CY := R * 189 / 30 - 94; C := 0;
130    WHILE C < 64 DO
140    BEGIN
150      CX := C * 234 / 63 - 180;
160      X := 0; Y := 0; N := 0; G := 1;
170      WHILE G = 1 DO
180      BEGIN
190        G := 0; A := X; IF X < 0 THEN A := - X;
200        B := Y; IF Y < 0 THEN B := - Y;
210        IF A < 182 THEN IF B < 182 THEN
220        BEGIN
230          XX := PEEK (SQ + A); IF A > 151 THEN XX := XX + 256;
240          YY := PEEK (SQ + B); IF B > 151 THEN YY := YY + 256;
250          IF XX + YY <= 360 THEN
260          BEGIN
270            Y := X * Y / S * 2 + CY; X := XX - YY + CX; N := N + 1;
280            IF N < MAXIT THEN G := 1
290          END
300        END
310      END;
320      V := 79; IF N > 9 THEN IF N < MAXIT THEN N := 9;
330      IF N < MAXIT THEN V := PEEK (PAL + N);
340      POKE SCR + R * 64 + C, V; C := C + 1;
350      IF C / 8 * 8 = C THEN IF KEY # 0 THEN BEGIN C := 64; R := 99 END
360    END;
370    R := R + 1
380  END;
390  IF R = 31 THEN
400  BEGIN
410    POKE 32824, 4; POKE 32825, 15; POKE 32826, 14; POKE 32827, 5;
420    WHILE KEY = 0 DO;
430    POKE 32824, 32; POKE 32825, 32; POKE 32826, 32; POKE 32827, 32
440  END;
450  CLS
460 END.
