{ A MAZE IN COMP80 PL/0 }
{ CARVES A RANDOM MAZE OF 42 BY 29 ROOMS OUT OF A SOLID SCREEN, }
{ THEN FINDS THE WAY FROM THE DOOR ON THE LEFT TO THE DOOR ON THE }
{ RIGHT BY FILLING IN EVERY DEAD END UNTIL ONLY THE WAY THROUGH IS }
{ LEFT. A ROOM IS TWO POINTS ACROSS AND ONE DOWN, WITH WALLS ONE }
{ THICK, SO A STEP IS 3 ACROSS AND 2 DOWN AND COMES OUT ABOUT }
{ SQUARE. A KEY STARTS THE FILLING IN AND ANOTHER CLEARS IT. RUN }
{ CLEARS THE VARIABLES, SO EACH RUN MAKES THE SAME MAZE. IT IS }
{ WRITTEN WITHOUT SPACES ROUND THE SIGNS TO LEAVE ROOM FOR ITS CODE. }
10 VAR S,T,CI,CJ,PX,PY,D,E,G,GX,GY,X,Y,A,M,C,F,PEN,I,N;
{ THE CHARACTER A AND BIT M OF POINT X,Y; F IS ODD IF IT IS SET }
20 PROCEDURE TST;
30 BEGIN
40 A:=32768+(Y/2+1)*64+X/2; M:=1; IF ODD X THEN M:=2;
50 IF ODD Y THEN M:=8/M; F:=PEEK A/M
60 END;
{ DOT SETS POINT X,Y WHEN PEN IS 1 AND CLEARS IT WHEN 0 }
70 PROCEDURE DOT;
80 BEGIN
90 IF ODD PEN THEN PLOT X,Y;
100 IF ODD PEN+1 THEN BEGIN
110  CALL TST; C:=PEEK A-M; IF C=64 THEN C:=32; IF ODD F THEN POKE A,C
120 END
130 END;
{ DIRECTIONS 0-3 ARE RIGHT, DOWN, LEFT, UP }
140 PROCEDURE DIR;
150 BEGIN GX:=0; GY:=0; IF ODD D THEN GY:=2-D; IF ODD D+1 THEN GX:=1-D END;
{ THE ROOM WE ARE IN, CI,CJ, AND ITS LEFT POINT PX,PY }
160 PROCEDURE AT;
170 BEGIN PX:=CI*3+1; PY:=CJ*2+3 END;
180 PROCEDURE GO;
190 BEGIN CALL DIR; CI:=CI+GX; CJ:=CJ+GY; CALL AT END;
200 PROCEDURE ROOM;
210 BEGIN PLOT PX,PY; PLOT PX+1,PY END;
{ THE WALL POINT ON SIDE D; WALL DRAWS THE WHOLE WALL }
220 PROCEDURE WXY;
230 BEGIN
240 CALL DIR; X:=PX+GX+(GX+1)/2; Y:=PY+GY
250 END;
260 PROCEDURE WALL;
270 BEGIN CALL WXY; CALL DOT; IF ODD D THEN BEGIN X:=X+1; CALL DOT END END;
{ A WAY TO A NEW ROOM, STILL SOLID, TRYING FROM A RANDOM SIDE, IN E, }
{ OR -1. A ROOM OFF THE TOP, BOTTOM OR RIGHT OF THE GRID WOULD BE ON }
{ A CLEAR POINT, SO ONLY THE LEFT SIDE NEEDS A TEST }
280 PROCEDURE TRY;
290 BEGIN
300 S:=S*31421+6927; T:=S/4096+8; E:=-1; I:=0;
310 WHILE I<4 DO BEGIN
320  D:=T+I; D:=D-D/4*4; CALL DIR; X:=PX+GX*3; Y:=PY+GY+GY;
330  CALL TST; IF X>0 THEN IF ODD F THEN E:=D;
360  I:=I+1
370 END
380 END;
{ CARVE: INTO A NEW ROOM IF THERE IS ONE, ELSE BACK A STEP. A ROOM }
{ ON THE WAY BACK KEEPS ITS RIGHT POINT SET UNTIL WE LEAVE IT FOR }
{ GOOD, SO THE WAY BACK IS THE ONE GAP TO A ROOM WITH IT SET }
390 PROCEDURE CARVE;
400 BEGIN
410 CI:=0; CJ:=0; CALL AT; X:=PX; Y:=PY; CALL DOT; G:=1;
420 WHILE G>0 DO BEGIN
430  CALL TRY;
440  IF E>=0 THEN BEGIN D:=E; CALL WALL; CALL GO; X:=PX; Y:=PY; CALL DOT END;
450  IF E<0 THEN BEGIN
460   X:=PX+1; Y:=PY; CALL DOT; G:=0; D:=0;
470   WHILE D<4 DO BEGIN
480    CALL WXY; CALL TST;
490    IF ODD F+1 THEN BEGIN
500     X:=PX+GX*3+1; Y:=PY+GY+GY; CALL TST; IF ODD F THEN E:=D
510    END;
520    D:=D+1
530   END;
540   IF E>=0 THEN BEGIN D:=E; CALL GO; G:=1 END
550  END
560 END
570 END;
{ THE GAPS ROUND THIS ROOM IN N, AND THE LAST ONE FOUND IN G }
580 PROCEDURE GAPS;
590 BEGIN
600 N:=0; D:=0;
610 WHILE D<4 DO BEGIN
620  CALL WXY; CALL TST; IF ODD F+1 THEN BEGIN N:=N+1; G:=D END; D:=D+1
630 END
640 END;
{ A ROOM WITH ONE GAP IS A DEAD END: FILL IT AND ITS DOOR, AND GO }
{ ON INTO THE NEXT ROOM, WHICH MAY BE ONE NOW }
650 PROCEDURE SOLVE;
660 BEGIN
670 PEN:=1; T:=0;
680 WHILE T<1218 DO BEGIN
690  CJ:=T/42; CI:=T-CJ*42; CALL AT; CALL GAPS;
700  WHILE N=1 DO BEGIN CALL ROOM; D:=G; CALL WALL; CALL GO; CALL GAPS END;
710  T:=T+1
720 END
730 END;
{ A SOLID SCREEN BELOW LINE 1, 127 BY 59 POINTS. AFTER CARVING, THE }
{ DOORS ARE OPENED AT 0,3 AND 126,59 }
780 BEGIN
790 CLS; A:=32768+128; WHILE A#32768+2048 DO BEGIN POKE A,79; A:=A+1 END;
800 I:=0;
810 WHILE I<64 DO BEGIN
820  POKE 32768+1984+I,67; IF I<29 THEN POKE 32768+191+I*64,73; I:=I+1
830 END;
840 POKE 32768+2047,65;
850 PEN:=0; CALL CARVE; POKE 32768+128,67; POKE 32768+1983,65;
860 WHILE KEY=0 DO;
870 CALL SOLVE;
880 WHILE KEY=0 DO;
890 CLS
900 END.
