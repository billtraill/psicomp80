{ ELEMENTARY CELLULAR AUTOMATA IN COMP80 PL/0 }
{ IT ASKS FOR A RULE NUMBER, 0-255, THEN GROWS A ROW OF 128 CELLS FROM ONE }
{ LIVE CELL, ONE GENERATION PER ROW OF QUARTER CHARACTERS DOWN THE SCREEN. }
{ EACH CELL'S NEXT STATE IS BIT L*4+C*2+R OF THE RULE, WHERE L C R ARE IT }
{ AND ITS NEIGHBOURS: TRY 30, 90 AND 110.  RT HOLDS THE 8 BITS OF THE }
{ RULE, ONE A BYTE, AND CA AND CB THE OLD AND NEW ROWS OF CELLS, 1-128, }
{ WITH A DEAD CELL AT EACH END.  THE THREE CELLS SLIDE ALONG AS ONE }
{ NUMBER, W, 0-7.  ABOUT 4 S; A KEY THEN CLEARS IT.  A KEY WHILE IT RUNS }
{ STOPS IT AND CLEARS THE SCREEN. }
10 CONST SCR = 32768, CA = 6656, CB = 6786, RT = 6916;
20 VAR R, O, N, T, W, X, Y, V, P, Q, I, C;
{ NUM WRITES P AT Q }
30 PROCEDURE NUM;
40 BEGIN
50   I := 1; WHILE I <= P / 10 DO I := I * 10;
60   WHILE I > 0 DO
70   BEGIN
80     POKE Q, 48 + P / I; P := P - P / I * I; I := I / 10; Q := Q + 1
90   END
100 END;
{ CH WRITES CHARACTER C AT Q; TXT WRITES THREE LETTERS PACKED IN W, }
{ 1024 * FIRST + 32 * SECOND + THIRD, WITH 0 FOR A SPACE }
110 PROCEDURE CH;
120 BEGIN IF C = 0 THEN C := 32; POKE Q, C; Q := Q + 1 END;
130 PROCEDURE TXT;
140 BEGIN
150   C := W / 1024; CALL CH; C := W / 32 - W / 1024 * 32; CALL CH;
160   C := W - W / 32 * 32; CALL CH
170 END;
180 BEGIN
190   ? R; CLS; Q := SCR + 64;
200   W := 5509; CALL TXT; W := 13486; CALL TXT; W := 20530; CALL TXT;
210   W := 25603; CALL TXT; W := 5516; CALL TXT; W := 21889; CALL TXT;
220   W := 18433; CALL TXT; W := 22159; CALL TXT; W := 13364; CALL TXT;
230   W := 15808; CALL TXT; Q := Q - 1; C := 44; CALL CH;
240   W := 597; CALL TXT; W := 12448; CALL TXT; P := R; CALL NUM;
250   I := 0; T := R;
260   WHILE I < 8 DO
270   BEGIN
280     V := 0; IF ODD T THEN V := 1;
290     POKE RT + I, V; T := T / 2; I := I + 1
300   END;
310   I := 0;
320   WHILE I < 130 DO BEGIN POKE CA + I, 0; POKE CB + I, 0; I := I + 1 END;
330   POKE CA + 65, 1; PLOT 64, 2;
340   O := CA; N := CB; Y := 3;
350   WHILE Y < 62 DO
360   BEGIN
370     W := PEEK O + PEEK O + PEEK (O + 1); X := 0;
380     WHILE X < 128 DO
390     BEGIN
400       W := W + W + PEEK (O + X + 2);
410       IF W > 7 THEN W := W - 8;
420       V := PEEK (RT + W); POKE N + X + 1, V;
430       IF V = 1 THEN PLOT X, Y;
440       X := X + 1
450     END;
460     T := O; O := N; N := T; Y := Y + 1;
470     IF KEY # 0 THEN Y := 99
480   END;
490   IF Y = 62 THEN WHILE KEY = 0 DO;
500   CLS
510 END.
