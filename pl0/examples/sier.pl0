{ SIERPINSKI TRIANGLE IN COMP80 PL/0 }
{ PASCAL'S TRIANGLE MOD 2, 64 ROWS OVER THE WHOLE SCREEN, TITLE LINE TOO, }
{ EACH ENTRY TWO CELLS WIDE, FOUR CELLS TO A CHARACTER, WITH POKE. }
{ ROW Y IS KEPT AS BYTES AT 6720 + X; GOING DOWN THE ROW, EACH ENTRY }
{ ADDS THE ONE TO ITS LEFT, AND ODD ENTRIES ARE DRAWN.  ROW Y STARTS AT }
{ CELL 63 - Y, SO ON AN ODD ROW AN ENTRY IS THE BOTTOM HALF OF ONE }
{ CHARACTER, AND ON AN EVEN ROW THE TOP RIGHT OF ONE AND THE TOP LEFT OF }
{ THE NEXT.  S ADDS QUARTER B TO THE CHARACTER AT Q. }
{ UNDER A SECOND; THEN ANY KEY CLEARS IT AND PUTS THE TITLE LINE BACK. }
10 VAR X, Y, A, B, Q, R, E;
20 PROCEDURE S;
30 BEGIN E := PEEK Q; IF E < 64 THEN E := 64; POKE Q, E + B END;
40 BEGIN
50   X := 0;
60   WHILE X < 64 DO
70   BEGIN POKE 6656 + X, PEEK (32768 + X); POKE 6720 + X, 0; X := X + 1 END;
80   X := 0;
90   WHILE X < 2048 DO BEGIN POKE 32768 + X, 32; X := X + 1 END;
100   POKE 6720, 1; Y := 0;
110   WHILE Y < 64 DO
120   BEGIN
130     R := 32768 + Y / 2 * 64 + 31 - Y / 2; X := Y;
140     WHILE X >= 0 DO
150     BEGIN
160       A := 6720 + X;
170       IF X > 0 THEN POKE A, PEEK A + PEEK (A - 1);
180       IF ODD PEEK A THEN
190       BEGIN
200         Q := R + X;
210         IF ODD Y THEN BEGIN B := 12; CALL S END;
220         IF ODD Y + 1 THEN
230         BEGIN B := 2; CALL S; Q := Q + 1; B := 1; CALL S END
240       END;
250       X := X - 1
260     END;
270     Y := Y + 1
280   END;
290   WHILE KEY = 0 DO;
300   CLS; X := 0;
310   WHILE X < 64 DO BEGIN POKE 32768 + X, PEEK (6656 + X); X := X + 1 END
320 END.
