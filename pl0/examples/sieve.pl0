{ SIEVE OF ERATOSTHENES IN COMP80 PL/0 }
{ THE NUMBERS 0-7679 ARE THE QUARTER CHARACTERS OF LINES 2-31, 128 TO A }
{ ROW, WITH Y FROM 4 TO 63 COUNTING FROM THE TOP OF LINE 0.  ALL START }
{ SET; FOR EACH PRIME P UP TO 87 THE MULTIPLES OF P FROM P*P ARE CLEARED, }
{ AND THE PRIMES ARE LEFT.  THEN IT COUNTS THEM: 973. }
{ * AND / ARE SLOW, SO THE MULTIPLES ARE STEPPED THROUGH BY ADDING P TO X }
{ AND CARRYING INTO Y, AND B IS THE ADDRESS OF Y'S LINE.  TABLES AT 6656 }
{ GIVE HALF OF X AND HOW MANY QUARTERS A CHARACTER HAS.  ABOUT 13 S; A }
{ KEY THEN CLEARS IT.  A KEY WHILE IT RUNS STOPS IT AND CLEARS THE SCREEN. }
10 CONST SCR = 32768, HALF = 6656, BITS = 6784;
20 VAR P, N, X, Y, B, A, C, G, J, K, M, Q, I, W;
{ NUM WRITES P AT Q }
30 PROCEDURE NUM;
40 BEGIN
50  I := 1; WHILE I <= P / 10 DO I := I * 10;
60  WHILE I > 0 DO
70  BEGIN POKE Q, 48 + P / I; P := P - P / I * I; I := I / 10; Q := Q + 1 END
80 END;
{ CH WRITES CHARACTER C AT Q; TXT WRITES THREE LETTERS PACKED IN W, }
{ 1024 * FIRST + 32 * SECOND + THIRD, WITH 0 FOR A SPACE }
90 PROCEDURE CH; BEGIN IF C = 0 THEN C := 32; POKE Q, C; Q := Q + 1 END;
100 PROCEDURE TXT;
110 BEGIN
120  C := W / 1024; CALL CH; C := W / 32 - W / 1024 * 32; CALL CH;
130  C := W - W / 32 * 32; CALL CH
140 END;
{ CROSS CLEARS NUMBER X, Y, GIVING G = 1 IF IT WAS SET.  ITS BIT M IS 1 }
{ TOP LEFT, 2 TOP RIGHT, 4 BOTTOM RIGHT AND 8 BOTTOM LEFT }
150 PROCEDURE CROSS;
160 BEGIN
170  A := B + PEEK (HALF + X); C := PEEK A; G := 0;
180  M := 1; IF ODD X THEN M := 2; IF ODD Y THEN M := 12 - M - M - M - M;
190  N := C / M;
200  IF C # 32 THEN IF ODD N THEN
210  BEGIN G := 1; N := C - M; IF N = 64 THEN N := 32; POKE A, N END
220 END;
230 BEGIN
240  CLS; I := 0;
250  WHILE I < 128 DO BEGIN POKE HALF + I, I / 2; I := I + 1 END;
260  I := 0;
270  WHILE I < 16 DO
280  BEGIN
290   N := I; C := 0;
300   WHILE N > 0 DO BEGIN IF ODD N THEN C := C + 1; N := N / 2 END;
310   POKE BITS + I, C; I := I + 1
320  END;
330  I := 0; WHILE I < 1920 DO BEGIN POKE SCR + 128 + I, 79; I := I + 1 END;
340  B := SCR + 128; Y := 4; X := 0; CALL CROSS; X := 1; CALL CROSS;
350  P := 2; J := 0; K := 0;
360  WHILE P < 88 DO
370  BEGIN
380   B := SCR + 128; Y := 4; X := P; CALL CROSS; POKE A, C;
390   IF G = 1 THEN
400   BEGIN
410    Q := SCR + 98; W := 3663; CALL TXT; W := 20073; CALL TXT;
420    W := 14560; CALL TXT; W := 16052; CALL TXT; Q := Q + 1; CALL NUM;
430    P := X; N := P * P; Y := N / 128 + 4; X := N - N / 128 * 128;
440    B := SCR + Y / 2 * 64;
450    WHILE Y < 64 DO
460    BEGIN
470     CALL CROSS; X := X + P;
480     WHILE X > 127 DO
490     BEGIN X := X - 128; Y := Y + 1; IF ODD Y + 1 THEN B := B + 64 END;
500     J := J + 1;
510     IF J = 256 THEN BEGIN J := 0; IF KEY # 0 THEN K := 1 END;
520     IF K = 1 THEN BEGIN Y := 64; P := 88 END
530    END
540   END;
550   P := P + 1
560  END;
570  IF K = 0 THEN
580  BEGIN
590   I := 0; N := 0;
600   WHILE I < 1920 DO
610   BEGIN
620    C := PEEK (SCR + 128 + I);
630    IF C # 32 THEN N := N + PEEK (BITS - 64 + C); I := I + 1
640   END;
650   Q := SCR + 98; W := 16969; CALL TXT; W := 13491; CALL TXT;
660   W := 207; CALL TXT; W := 21956; CALL TXT; Q := Q + 1; P := N; CALL NUM;
670   WHILE KEY = 0 DO
680  END;
690  CLS
700 END.
