{ SNAKE IN COMP80 PL/0 }
{ W A S D STEER, Q STOPS. EAT THE DOTS TO GROW; DON'T HIT THE WALL }
{ OR YOURSELF. ANY KEY STARTS A GAME, AND AFTER A CRASH ANY KEY }
{ PLAYS AGAIN. }
{ THE FIELD IS IN HALF CHARACTERS, ABOUT SQUARE: X 0-63, Y 4-63, }
{ THE TOP OR BOTTOM HALF OF LINE Y / 2. THE SNAKE AND THE WALLS }
{ FILL BOTH QUARTERS OF A HALF, A DOT ONE. }
{ THE BODY IS WHERE THE SNAKE HAS BEEN, FROM THE TAIL TL TO THE HEAD }
{ HD: X AT BX + I AND Y AT BY + I, GOING ROUND 256 PLACES. THE }
{ VARIABLES ARE TWO BYTES EACH FROM 7168 ON, IN THE ORDER DECLARED, }
{ SO PEEK 7168 AND PEEK 7170, THE LOW BYTES OF HD AND TL, GO ROUND }
{ BY THEMSELVES. }
10 CONST BX=6656, BY=6912;
20 VAR HD,TL,X,Y,A,T,H,Z,V,HX,HY,DX,DY,NX,NY,PX,PY,GR,SC,QT,K,I,S,R,M;
30 PROCEDURE RND; BEGIN S:=S*31421+6927; R:=(S/128+256)*M/512 END;
{ LOOK FINDS X Y: ITS CHARACTER'S QUARTERS T, THOSE IN ITS HALF H, }
{ AND Z, 1 FOR THE TOP HALF AND 4 FOR THE BOTTOM. A SPACE IS 32 AND }
{ A QUARTER BLOCK 64 + T, SO T IS THE CHARACTER LESS ITS 16S. SET PUTS }
{ Z * V IN ITS HALF: 0 EMPTY, 3 FULL, 2 A DOT }
40 PROCEDURE LOOK;
50  BEGIN A:=32768+Y/2*64+X; T:=PEEK A-PEEK A/16*16; H:=T-T/4*4; Z:=1;
60  IF ODD Y THEN BEGIN H:=T-H; Z:=4 END END;
70 PROCEDURE SET;
80  BEGIN T:=T-H+Z*V; IF T=0 THEN T:=-32; POKE A,T+64 END;
90 PROCEDURE FOOD;
100  BEGIN H:=1;
110  WHILE H#0 DO BEGIN M:=62; CALL RND; X:=R+1; M:=58; CALL RND; Y:=R+5;
120   CALL LOOK END;
130  V:=2; CALL SET END;
140 PROCEDURE HEAD;
150  BEGIN V:=3; CALL SET; POKE BX+PEEK 7168,X; POKE BY+PEEK 7168,Y;
160  HD:=HD+1 END;
170 PROCEDURE SHOW; BEGIN POKE 32839,SC/10+48; POKE 32840,SC-SC/10*10+48 END;
{ MOVE ONE PLACE ON; QT IS 2 IF THE SNAKE HIT SOMETHING. EACH DOT IS }
{ WORTH A POINT AND THREE MORE PIECES OF SNAKE }
180 PROCEDURE MOVE;
190  BEGIN IF GR=0 THEN BEGIN X:=PEEK (BX+PEEK 7170);
200   Y:=PEEK (BY+PEEK 7170); CALL LOOK; V:=0; CALL SET; TL:=TL+1 END;
210  IF GR>0 THEN GR:=GR-1;
220  X:=HX+DX; Y:=HY+DY; CALL LOOK; IF H=Z*3 THEN QT:=2;
230  IF QT=0 THEN BEGIN HX:=X; HY:=Y; CALL HEAD;
240   IF H#0 THEN BEGIN SC:=SC+1; GR:=GR+3; CALL SHOW; CALL FOOD END END END;
{ A KEY: TURN, UNLESS IT WOULD GO BACK ON ITSELF }
250 PROCEDURE STEER;
260  BEGIN NX:=0; NY:=0; IF K=23 THEN NY:=-1; IF K=1 THEN NX:=-1;
270  IF K=19 THEN NY:=1; IF K=4 THEN NX:=1; IF K=17 THEN QT:=1;
280  IF NX+NY#0 THEN IF NX+DX+(NY+DY)*2#0 THEN BEGIN PX:=NX; PY:=NY END
290  END;
{ WAIT FOR A KEY, STIRRING THE RANDOM NUMBERS MEANWHILE }
300 PROCEDURE WAIT; BEGIN K:=0; WHILE K=0 DO BEGIN S:=S+1; K:=KEY END END;
310 PROCEDURE SETUP;
320  BEGIN CLS; POKE 32833,19; POKE 32834,3; POKE 32835,15; POKE 32836,18;
330  POKE 32837,5; I:=0; A:=32896;
340  WHILE I<64 DO BEGIN POKE A+I,67; POKE A+1856+I,76; I:=I+1 END;
350  I:=0; WHILE I<1900 DO BEGIN POKE A+I,79; POKE A+I+63,79; I:=I+64 END;
360  TL:=HD; GR:=0; SC:=0; QT:=0; DX:=1; DY:=0; PX:=1; PY:=0;
370  CALL SHOW; Y:=33; X:=28;
380  WHILE X<32 DO BEGIN CALL LOOK; CALL HEAD; X:=X+1 END;
390  HX:=31; HY:=33; CALL FOOD; CALL WAIT; CALL STEER END;
{ EACH STEP WAITS 8 KEYS, TAKING THEM AS THEY COME, ONE FEWER FOR }
{ EVERY FOURTH DOT, DOWN TO 3 }
400 BEGIN
410  WHILE QT#1 DO BEGIN CALL SETUP;
420   WHILE QT=0 DO BEGIN I:=8-SC/4; IF I<3 THEN I:=3;
430    WHILE I>0 DO BEGIN K:=KEY; CALL STEER; I:=I-1 END;
440    DX:=PX; DY:=PY; IF QT=0 THEN CALL MOVE END;
450   IF QT=2 THEN BEGIN CALL WAIT; QT:=0; CALL STEER END
460  END;
470  CLS
480 END.
