{ A STARFIELD IN COMP80 PL/0 }
{ FLIES THROUGH 16 STARS UNTIL A KEY IS PRESSED. EACH STAR FLIES }
{ STRAIGHT OUT FROM THE MIDDLE, GOING FASTER AS IT COMES, AND IS }
{ FLIPPED WITH XOR, SO DRAWING IT AGAIN RUBS IT OUT. }
{ THE VARIABLES ARE TWO BYTES EACH FROM 7168 ON, IN THE ORDER }
{ DECLARED. A STAR IS SEVEN OF THEM, 14 BYTES: X Y, SPEED VX VY, ITS }
{ GAIN IN SPEED AX AY, AND AGE G. EACH STAR IS COPIED FROM ITS PLACE }
{ AT ST INTO THEM AND BACK. POSITIONS AND SPEEDS ARE IN 128THS OF A }
{ POINT, SO THE HIGH BYTE OF X IS THE COLUMN, OF Y THE LINE, AND A }
{ LOW BYTE OF 128 OR MORE MEANS THE RIGHT OR BOTTOM HALF OF IT. }
10 CONST N=16, XT=6624, LT=6784, HT=6815, ST=6848;
20 VAR X, Y, VX, VY, AX, AY, G, PX, PY, A, I, J, K, M, Q, R, S, D, E, KS;
30 PROCEDURE RND;
40  BEGIN S := S*31421+6927; R := S/128; IF R < 0 THEN R := R+256;
50   R := R*M/256 END;
{ PIX FLIPS THE POINT AT PX PY. LT AND HT HOLD THE LOW AND HIGH BYTES }
{ OF THE ADDRESS OF EACH LINE. K PICKS THE QUARTER: XT + K + 32 }
{ HOLDS THE CHARACTER FOR A SPACE WITH IT SET, AND XT + K + 64 + Q }
{ FOR QUARTERS Q WITH IT FLIPPED. }
60 PROCEDURE PIX;
70  BEGIN POKE 7186, PEEK (LT+PEEK 7185)+PEEK 7183;
80   POKE 7187, PEEK (HT+PEEK 7185);
90   K := 0; IF PEEK 7182 >= 128 THEN K := 16;
100  IF PEEK 7184 >= 128 THEN K := 80-K;
110  POKE A, PEEK (XT+K+PEEK A) END;
{ CP COPIES A STAR FROM E TO D }
120 PROCEDURE CP;
130  BEGIN K := D+14;
140   WHILE D < K DO BEGIN POKE D, PEEK E; POKE D+1, PEEK (E+1);
150    D := D+2; E := E+2 END END;
{ AN OLD STAR IS NEARER, AND TWO POINTS WIDE }
160 PROCEDURE DRAW;
170  BEGIN PX := X; PY := Y; CALL PIX;
180   IF G > 12 THEN BEGIN PX := X+128; CALL PIX END END;
190 PROCEDURE GO;
200  BEGIN VX := VX+AX; VY := VY+AY; X := X+VX; Y := Y+VY; G := G+1 END;
{ A STAR GONE OFF THE SCREEN, OR OLD, STARTS AGAIN FROM THE MIDDLE }
{ IN A RANDOM DIRECTION. A CHARACTER IS 5/3 AS TALL AS IT IS WIDE, }
{ SO Y GOES 3/5 AS FAR }
210 PROCEDURE ON;
220  BEGIN E := 0; IF X < 0 THEN E := 1; IF X >= 16128 THEN E := 1;
230   IF Y < 0 THEN E := 1; IF Y >= 7936 THEN E := 1;
240   IF G >= 80 THEN E := 1;
250   IF E = 1 THEN BEGIN X := 8192; Y := 3968; G := 0; M := 63;
260    CALL RND; AX := R-31; VX := AX*4;
270    CALL RND; AY := (R-31)*3/5; VY := AY*4 END END;
280 PROCEDURE STEP;
290  BEGIN D := 7168; E := J; CALL CP; CALL DRAW; CALL GO; CALL ON;
300   CALL DRAW; D := J; E := 7168; CALL CP END;
310 BEGIN
{ FLIPPING BIT M OF Q ADDS M OR TAKES IT AWAY }
320  M := 1;
330  WHILE M < 16 DO BEGIN POKE XT+K+32, M+64; Q := 0;
340   WHILE Q < 16 DO BEGIN R := Q+M; IF ODD Q/M THEN R := Q-M;
350    IF R = 0 THEN R := -32; POKE XT+K+64+Q, R+64; Q := Q+1 END;
360   M := M+M; K := K+16; IF K = 32 THEN K := 64 END;
370  I := 0;
380  WHILE I < 31 DO BEGIN A := 32768+I*64+64;
390   POKE LT+I, PEEK 7186; POKE HT+I, PEEK 7187; I := I+1 END;
{ TO START WITH, THE STARS ARE ALREADY ON THEIR WAY }
400  CLS; I := 0; J := ST;
410  WHILE I < N DO BEGIN G := 80; CALL ON; M := 40; CALL RND;
420   WHILE R >= 0 DO BEGIN CALL GO; R := R-1 END;
430   CALL ON; CALL DRAW; D := J; E := 7168; CALL CP; I := I+1; J := J+14
440  END;
450  WHILE KS = 0 DO BEGIN I := 0; J := ST;
460   WHILE I < N DO BEGIN CALL STEP; IF ODD I THEN KS := KEY+KS;
470    I := I+1; J := J+14 END
480  END;
490  CLS
500 END.
