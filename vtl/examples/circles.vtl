10 ) CIRCLES BY THE MIDPOINT RULE, WITH ADDING ONLY
20 I=0
30 ?="" CLEAR THE SCREEN BY SCROLLING IT
40 I=I+1
50 #=(I<31)*30
60 W=64
70 C=31
80 R=6
90 X=0
100 Y=R
110 E=1001-R THE ERROR, PLUS 1000 SO IT STAYS POSITIVE
120 P=X*5/3 POINTS ARE TALL: STRETCH ACROSS
130 Q=Y*5/3
140 #=300
150 X=X+1
160 #=(E<1000)*200
170 Y=Y-1
180 E=E+X+X-Y-Y+1
190 #=210
200 E=E+X+X+1
210 #=(X<(Y+1))*120
220 R=R+6
230 #=(R<31)*90
240 K=$ WAIT FOR A KEY
250 #=999
300 @=(C+Y)*128+W+P
310 @=(C-Y)*128+W+P
320 @=(C+Y)*128+W-P
330 @=(C-Y)*128+W-P
340 @=(C+X)*128+W+Q
350 @=(C-X)*128+W+Q
360 @=(C+X)*128+W-Q
370 @=(C-X)*128+W-Q
380 #=!
